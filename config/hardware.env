# Perfil de hardware detectado en el host de desarrollo (Intel N100 · ~8 GiB RAM · iGPU).
# Ajusta estos valores si el equipo cambia.

HARDWARE_PROFILE=n100-8g
CPU_CORES=4
RAM_GIB=8
HAS_NVIDIA_GPU=0

# Modelo Ollama recomendado para este perfil (CPU-only, cabe en RAM con margen para Docker).
OLLAMA_MODEL=qwen2.5-coder:1.5b
# Alternativa si hay más RAM libre (~3 GiB modelo + contexto): qwen2.5-coder:3b
# OLLAMA_MODEL=qwen2.5-coder:3b

# OpenHands necesita contexto grande; en 8 GiB no conviene 32k.
# 16384 equilibra prompt del agente y presión de memoria en CPU.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_KEEP_ALIVE=30m

# Límites Docker (OpenHands UI + sandbox).
OPENHANDS_MEMORY=2g
OPENHANDS_CPUS=2
SANDBOX_MEMORY=1g

OPENHANDS_PORT=3000
OPENHANDS_IMAGE=docker.openhands.dev/openhands/openhands:1.8
AGENT_SERVER_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
AGENT_SERVER_IMAGE_TAG=1.26.0-python

LLM_MODEL=openai/qwen2.5-coder:1.5b
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local-llm
